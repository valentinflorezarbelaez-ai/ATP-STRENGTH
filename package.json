{
  "name": "atp-strength-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix atp-strength-frontend",
    "dev:backend": "cd atp-strength-backend && .venv\\Scripts\\uvicorn main:app --reload --port 8000",
    "build:frontend": "npm run build --prefix atp-strength-frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
